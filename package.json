{
  "name": "hampers-by-her",
  "version": "2.0.0",
  "description": "Artisanal Luxury Gifting Digital Commerce Ecosystem & Atelier OS",
  "private": true,
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "build": "node scripts/build_vercel_public.js",
    "vercel-build": "node scripts/build_vercel_public.js",
    "test": "node --test tests/*.test.js platform/tests/*.test.js",
    "test:commerce": "node --test tests/*.test.js",
    "test:platform": "node --test platform/tests/*.test.js",
    "test:e2e": "node --test tests/e2e_integration.test.js",
    "test:dsa": "node --test tests/dsa_computational_suite.test.js",
    "test:auth": "node --test tests/auth_service.test.js",
    "test:admin": "node --test tests/admin_studio_ops.test.js",
    "test:courier": "node --test tests/logistics_courier.test.js",
    "test:voice": "node --test tests/voice_gateway.test.js",
    "build:apk": "node scripts/build_android_apk.js",
    "benchmark": "node scripts/benchmark_runtime.js",
    "audit:docs": "node scripts/audit_documentation.js",
    "verify": "npm run audit:docs && npm test && npm run build:apk"
  },
  "keywords": [
    "gifting",
    "ecommerce",
    "luxury-hampers",
    "modular-monolith",
    "nextjs",
    "nestjs",
    "prisma"
  ],
  "author": "Hampers by Her Engineering Team",
  "license": "UNLICENSED",
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "@vercel/functions": "^3.11.4",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "pg": "^8.23.1",
    "ws": "^8.21.3"
  }
}

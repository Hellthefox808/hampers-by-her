// Hampers by Her - Canonical Prisma Schema
// Database: PostgreSQL 16 (Aurora Serverless v2)

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  SUPER_ADMIN
  OPERATIONS
  SALES
  FULFILLMENT
  CUSTOMER_SUPPORT
  ARTISAN
  CUSTOMER
  FINANCE
  VIEWER
}

enum ProductType {
  READY_MADE
  BUILDER_COMPONENT
  PACKAGING_BOX
  PACKAGING_RIBBON
  PACKAGING_WAX_SEAL
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  CONFIRMED
  IN_PRODUCTION
  QUALITY_CHECKED
  PACKED
  DISPATCHED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  CREATED
  INITIATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  REQUIREMENTS_COLLECTED
  QUOTATION_SENT
  NEGOTIATION
  WON
  FULFILLMENT
  LOST
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name")
  role         UserRole  @default(OPERATIONS)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("users")
}

model Customer {
  id           String    @id @default(uuid()) @db.Uuid
  email        String?   @unique
  phoneNumber  String?   @unique @map("phone_number")
  fullName     String    @map("full_name")
  isGuest      Boolean   @default(false) @map("is_guest")
  addresses    Address[]
  orders       Order[]
  carts        Cart[]
  conversations WhatsAppConversation[]
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("customers")
}

model Address {
  id           String    @id @default(uuid()) @db.Uuid
  customerId   String?   @map("customer_id") @db.Uuid
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  recipientName String   @map("recipient_name")
  addressLine1 String    @map("address_line1")
  addressLine2 String?   @map("address_line2")
  landmark     String?
  pincode      String    @db.VarChar(6)
  city         String
  state        String
  phoneNumber  String    @map("phone_number")
  isDefault    Boolean   @default(false) @map("is_default")
  orders       Order[]
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([pincode])
  @@map("addresses")
}

model Product {
  id             String       @id @default(uuid()) @db.Uuid
  sku            String       @unique
  slug           String       @unique
  title          String
  subtitle       String?
  description    String?
  productType    ProductType  @map("product_type")
  basePricePaise BigInt       @map("base_price_paise")
  isCustomizable Boolean      @default(false) @map("is_customizable")
  isFragile      Boolean      @default(false) @map("is_fragile")
  volumeCm3      Decimal      @default(0.0) @map("volume_cm3") @db.Decimal(10, 2)
  weightGrams    Int          @default(0) @map("weight_grams")
  images         ProductImage[]
  inventory      Inventory?
  categories     ProductCategoryMapping[]
  occasions      ProductOccasionMapping[]
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  deletedAt      DateTime?    @map("deleted_at")

  @@index([productType])
  @@map("products")
}

model ProductImage {
  id         String   @id @default(uuid()) @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url        String
  altText    String   @map("alt_text")
  blurHash   String?  @map("blur_hash")
  sortOrder  Int      @default(0) @map("sort_order")
  isPrimary  Boolean  @default(false) @map("is_primary")

  @@map("product_images")
}

model Inventory {
  productId         String   @id @map("product_id") @db.Uuid
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  availableQuantity Int      @map("available_quantity")
  reservedQuantity  Int      @default(0) @map("reserved_quantity")
  lowStockThreshold Int      @default(5) @map("low_stock_threshold")
  version           Int      @default(1)

  @@map("inventory")
}

model ProductCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  slug        String   @unique
  description String?
  products    ProductCategoryMapping[]

  @@map("product_categories")
}

model ProductCategoryMapping {
  productId  String          @map("product_id") @db.Uuid
  categoryId String          @map("category_id") @db.Uuid
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@map("product_category_mappings")
}

model Occasion {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  slug        String   @unique
  description String?
  products    ProductOccasionMapping[]

  @@map("occasions")
}

model ProductOccasionMapping {
  productId  String   @map("product_id") @db.Uuid
  occasionId String   @map("occasion_id") @db.Uuid
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  occasion   Occasion @relation(fields: [occasionId], references: [id], onDelete: Cascade)

  @@id([productId, occasionId])
  @@map("product_occasion_mappings")
}

model Cart {
  id         String     @id @default(uuid()) @db.Uuid
  customerId String?    @map("customer_id") @db.Uuid
  customer   Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  sessionId  String     @unique @map("session_id")
  items      CartItem[]
  expiresAt  DateTime   @map("expires_at")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  @@map("carts")
}

model CartItem {
  id             String   @id @default(uuid()) @db.Uuid
  cartId         String   @map("cart_id") @db.Uuid
  cart           Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productSku     String   @map("product_sku")
  quantity       Int      @default(1)
  configuration  Json?    @db.JsonB // Stores composite builder selections
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("cart_items")
}

model Order {
  id                  String         @id @default(uuid()) @db.Uuid
  orderNumber         String         @unique @map("order_number")
  customerId          String?        @map("customer_id") @db.Uuid
  customer            Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  shippingAddressId   String         @map("shipping_address_id") @db.Uuid
  shippingAddress     Address        @relation(fields: [shippingAddressId], references: [id])
  orderStatus         OrderStatus    @default(DRAFT) @map("order_status")
  subtotalPaise       BigInt         @map("subtotal_paise")
  discountPaise       BigInt         @default(0) @map("discount_paise")
  shippingFeePaise    BigInt         @default(0) @map("shipping_fee_paise")
  taxPaise            BigInt         @default(0) @map("tax_paise")
  totalAmountPaise    BigInt         @map("total_amount_paise")
  currency            String         @default("INR") @db.VarChar(3)
  isGift              Boolean        @default(true) @map("is_gift")
  deliveryPreferredDate DateTime     @map("delivery_preferred_date") @db.Date
  deliverySlot        String?        @map("delivery_slot")
  idempotencyKey      String?        @unique @map("idempotency_key") @db.Uuid
  items               OrderItem[]
  payments            Payment[]
  timeline            OrderTimelineEvent[]
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  @@index([orderStatus, createdAt(sort: Desc)])
  @@map("orders")
}

model OrderItem {
  id             String   @id @default(uuid()) @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productSku     String   @map("product_sku")
  title          String
  unitPricePaise BigInt   @map("unit_price_paise")
  quantity       Int      @default(1)
  configuration  Json?    @db.JsonB // Immutable snapshot of components & personalization
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("order_items")
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  orderId           String        @map("order_id") @db.Uuid
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  gatewayProvider   String        @default("RAZORPAY") @map("gateway_provider")
  gatewayOrderId    String        @unique @map("gateway_order_id")
  gatewayPaymentId  String?       @unique @map("gateway_payment_id")
  amountPaise       BigInt        @map("amount_paise")
  currency          String        @default("INR") @db.VarChar(3)
  paymentStatus     PaymentStatus @default(CREATED) @map("payment_status")
  paymentMethod     String?       @map("payment_method") // UPI, CARD, NETBANKING
  rawGatewayResponse Json?        @map("raw_gateway_response") @db.JsonB
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  @@map("payments")
}

model OrderTimelineEvent {
  id          String      @id @default(uuid()) @db.Uuid
  orderId     String      @map("order_id") @db.Uuid
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus  OrderStatus? @map("from_status")
  toStatus    OrderStatus @map("to_status")
  triggeredBy String      @map("triggered_by")
  metadata    Json?       @db.JsonB
  createdAt   DateTime    @default(now()) @map("created_at")

  @@index([orderId, createdAt])
  @@map("order_timeline_events")
}

model WhatsAppConversation {
  id             String    @id @default(uuid()) @db.Uuid
  customerId     String?   @map("customer_id") @db.Uuid
  customer       Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  waPhoneNumber  String    @unique @map("wa_phone_number")
  leadStage      LeadStage @default(NEW) @map("lead_stage")
  lastMessageAt  DateTime  @default(now()) @map("last_message_at")
  assignedUserId String?   @map("assigned_user_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("whatsapp_conversations")
}

model OtpSession {
  id        String   @id @default(uuid()) @db.Uuid
  phone     String   @db.VarChar(20)
  otpHash   String   @map("otp_hash")
  expiresAt DateTime @map("expires_at")
  verified  Boolean  @default(false)
  attempts  Int      @default(0)
  channel   String   @default("WHATSAPP") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([phone, expiresAt])
  @@map("otp_sessions")
}

model QualityCheckRecord {
  id             String   @id @default(uuid()) @db.Uuid
  orderNumber    String   @map("order_number") @db.VarChar(64)
  inspectorId    String   @map("inspector_id") @db.VarChar(64)
  inspectorName  String   @map("inspector_name") @db.VarChar(128)
  passed         Boolean  @default(true)
  photoProofUrl  String   @map("photo_proof_url")
  photoProofHash String   @map("photo_proof_hash") @db.VarChar(128)
  notes          String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([orderNumber])
  @@map("quality_check_records")
}

model LogisticsShipment {
  id                String              @id @default(uuid()) @db.Uuid
  orderNumber       String              @unique @map("order_number") @db.VarChar(64)
  awbNumber         String              @unique @map("awb_number") @db.VarChar(64)
  carrier           String              @db.VarChar(64)
  trackingStatus    String              @map("tracking_status") @db.VarChar(32)
  labelUrl          String?             @map("label_url")
  grossWeightG      Int                 @map("gross_weight_g")
  pickupSlot        String?             @map("pickup_slot") @db.VarChar(64)
  estimatedDelivery DateTime?           @map("estimated_delivery")
  checkpoints       CarrierCheckpoint[]
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  @@index([awbNumber])
  @@map("logistics_shipments")
}

model CarrierCheckpoint {
  id             String            @id @default(uuid()) @db.Uuid
  shipmentId     String            @map("shipment_id") @db.Uuid
  shipment       LogisticsShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status         String            @db.VarChar(32)
  location       String            @db.VarChar(128)
  timestamp      DateTime
  message        String            @db.VarChar(255)
  carrierRawCode String?           @map("carrier_raw_code") @db.VarChar(64)
  createdAt      DateTime          @default(now()) @map("created_at")

  @@index([shipmentId, timestamp])
  @@map("carrier_checkpoints")
}

model NotificationDispatchLog {
  id                String   @id @default(uuid()) @db.Uuid
  event             String   @db.VarChar(64)
  channel           String   @db.VarChar(20)
  recipient         String   @db.VarChar(128)
  orderNumber       String?  @map("order_number") @db.VarChar(64)
  status            String   @db.VarChar(32)
  templateId        String?  @map("template_id") @db.VarChar(64)
  externalMessageId String?  @map("external_message_id") @db.VarChar(128)
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([orderNumber, event])
  @@map("notification_dispatch_logs")
}

model DsaAlgorithmMetric {
  id                  String   @id @default(uuid()) @db.Uuid
  algorithmName       String   @map("algorithm_name") @db.VarChar(64)
  executionDurationMs Float    @map("execution_duration_ms")
  inputSize           Int      @map("input_size")
  outputSummary       String?  @map("output_summary") @db.Text
  createdAt           DateTime @default(now()) @map("created_at")

  @@index([algorithmName, createdAt])
  @@map("dsa_algorithm_metrics")
}

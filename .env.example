# ==============================================================================
# HAMPERS BY HER — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to `.env` for local development or inject via Secrets Manager.
# NEVER commit `.env` or real production credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Server Runtime
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Comma-separated browser origins allowed by CORS in production (empty = permissive dev mode)
ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=info
# Set to "json" for structured production logs
LOG_FORMAT=pretty

# ------------------------------------------------------------------------------
# Authentication & Studio OS Operations Security
# ------------------------------------------------------------------------------
# Required in production (>= 16 chars) for signing customer & staff HS256 JWTs
JWT_SECRET=replace_with_32_plus_char_random_secret
# Required in production for Studio OS (/admin) staff PIN login
STUDIO_ADMIN_PIN=replace_with_secure_studio_pin
# Enforce staff RBAC headers in staging/production ("true" in prod, optional in local dev)
REQUIRE_ADMIN_AUTH=false
# Set "true" only for load/unit test runners that intentionally bypass sliding-window limiters
DISABLE_RATE_LIMIT=false

# ------------------------------------------------------------------------------
# PostgreSQL / Prisma Persistence (Cloud / Docker Compose Stack)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://hbh_user:replace_with_password@localhost:5432/hampers_by_her?sslmode=disable

# ------------------------------------------------------------------------------
# Voice AI Gateway & Telephony Integrations (Optional — offline fallback active)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_REALTIME_VOICE=alloy
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=
VAPI_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# Meta WhatsApp Business Cloud API & Instagram Graph API (Optional — sandbox active)
# ------------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_VERIFY_TOKEN=

# ------------------------------------------------------------------------------
# Native Android APK Toolchain Overrides (Optional — auto-discovered on host)
# ------------------------------------------------------------------------------
ANDROID_HOME=
JAVA_HOME=

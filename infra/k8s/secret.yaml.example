apiVersion: v1
kind: Secret
metadata:
  name: hbh-app-secrets
  namespace: hampers-by-her
  labels:
    app.kubernetes.io/name: hampers-by-her
type: Opaque
stringData:
  DATABASE_URL: "postgresql://hbh_admin:CHANGE_ME_PASSWORD@hbh-aurora-cluster.ap-south-1.rds.amazonaws.com:5432/hampers_by_her?sslmode=require"
  REDIS_URL: "redis://:CHANGE_ME_REDIS_AUTH@hbh-redis-cluster.ap-south-1.cache.amazonaws.com:6379/0"
  JWT_SECRET: "CHANGE_ME_PRODUCTION_JWT_SECRET_32_CHARS_MINIMUM"
  RAZORPAY_KEY_ID: "rzp_live_placeholder"
  RAZORPAY_KEY_SECRET: "rzp_secret_placeholder"
  WHATSAPP_ACCESS_TOKEN: "meta_waba_token_placeholder"
